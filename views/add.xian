{{>head}}

    <form action="/insert" method="POST">
        <label for="BrandName">BrandName</label>
        <input type="text" name="BrandName" placeholder="BrandName">
        <label for="DeviceName">DeviceName</label>
        <input type="text" name="DeviceName" placeholder="DeviceName">
        <label for="Specs">Specs</label>
        <input type="text" name="Specs" placeholder="Specs">
        <label for="Price">Price</label>
        <input type="text" name="Price" placeholder="Price">
        <label for="DateReleased">DateReleased</label>
        <input type="text" name="DateReleased" placeholder="DateReleased">
        <input type="submit" name="save">
    </form>